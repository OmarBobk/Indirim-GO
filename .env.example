APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ASCII-safe folder name for spatie/laravel-backup ({BACKUP_NAME}/timestamp.zip).
# Do not use Turkish "İ" / other non-ASCII here — it breaks destination writes on some hosts.
BACKUP_NAME=karman

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase / FCM (admin push notifications)
FIREBASE_PROJECT_ID=indirimgo
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
VITE_FIREBASE_API_KEY=AIzaSyAA3R7x__c2DmFtQV4qd93Ry-GqkPPyF-A
VITE_FIREBASE_AUTH_DOMAIN=indirimgo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=indirimgo
VITE_FIREBASE_STORAGE_BUCKET=indirimgo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=389415697778
VITE_FIREBASE_APP_ID=1:389415697778:web:2be724bcd2ee19250471eb
VITE_FIREBASE_MEASUREMENT_ID=G-Z3NXX6G1S0
# Required for FCM web push. Get it: Firebase Console → Project settings → Cloud Messaging → Web Push certificates (generate or copy key pair).
VITE_FIREBASE_VAPID_KEY=

# Cloudflare Turnstile (registration bot protection). Keep disabled for local dev.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5

# Browser fulfillment automation (Laravel orchestration + automation-worker)
FULFILLMENT_AUTOMATION_ENABLED=false
FULFILLMENT_AUTOMATION_WORKER_URL=http://127.0.0.1:3100
FULFILLMENT_AUTOMATION_CALLBACK_SECRET=
FULFILLMENT_AUTOMATION_WASIM_USERNAME=
FULFILLMENT_AUTOMATION_WASIM_PASSWORD=
FULFILLMENT_AUTOMATION_ACME_USERNAME=
FULFILLMENT_AUTOMATION_ACME_PASSWORD=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
